<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- This property makes the build directory similar to a publish directory and helps the AWS .NET Lambda Mock Test Tool find project dependencies. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Generate ready to run images during publishing to improve cold start time. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <UserSecretsId>d5b2da5a-a043-416b-bf88-13d47ad6acdd</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <!-- Referenced explicitly (not just transitively via DooDuckInn.csproj): EF's
         ApplyConfigurationsFromAssembly reaches Relational extension methods (HasIndex,
         HasCheckConstraint) only via reflection, so the Lambda packaging step — which
         walks this project's own reference graph, not the referenced project's — was
         leaving Microsoft.EntityFrameworkCore.Relational.dll out of the deployed zip.
         Relational is pinned to match DooDuckInn.csproj's EF Core version explicitly:
         Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 alone pulls Relational 10.0.4
         transitively, which conflicts with the 10.0.12 DooDuckInn.dll was built against
         - the exact version mismatch that caused the original FileNotFoundException. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <ProjectReference Include="..\DooDuckInn\DooDuckInn.csproj" />
  </ItemGroup>
</Project>